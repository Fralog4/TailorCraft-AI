# ==========================================
# Root .gitignore for AI ATS Resume Tailor
# ==========================================

# Environment & Secrets (NEVER COMMIT REAL KEYS)
.env
.env.local
.env.*.local
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
venv/
.venv/
ENV/
env/

# Node.js & Vite Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Logs & Temporary files
logs/
*.log
*.tmp
*.temp
output_*.pdf
output_*.docx
temp_*
test_resume.*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
