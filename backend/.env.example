# ==========================================
# Backend Configuration Example (.env.example)
# ==========================================

# Port and host
PORT=8000
HOST=127.0.0.1

# Allowed CORS Origins (comma-separated list).
# In production, replace with your frontend deployment URL(s).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum upload file size in bytes (Default: 15MB = 15728640 bytes)
MAX_FILE_SIZE_BYTES=15728640
